# Supersedes aggregate/columns/Reddit publishing entries; preserve other cron jobs.
# Timeout MUST run inside the container so it kills Node, not just docker's client.
*/5 * * * * flock -n /run/lock/cali-reporter-aggregate.lock docker exec -e LOCALFLEET_ARTICLE_BASE_URL=https://api.onetimesuite.com/cali cali-reporter timeout --signal=TERM --kill-after=30s 20m node /app/scripts/hourly-writers.js --scope=all --max-jobs=12 --budget-seconds=240 --concurrency=1 >> /var/log/cali-reporter-hourly-writers.log 2>&1
